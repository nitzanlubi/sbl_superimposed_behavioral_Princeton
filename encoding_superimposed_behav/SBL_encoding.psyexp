        <Param val="if ((key_related === &quot;q&quot;)) {&amp;#10;    text_relatedness = &quot;If they are related, press Q\nIf they are unrelated, press P\n\nIMPORTANT: you should press P or Q only when you see the question, AFTER the scene and item disappeared from the screen!\n\nPress SPACEBAR to start.&quot;;&amp;#10;} else {&amp;#10;    if ((key_related === &quot;p&quot;)) {&amp;#10;        text_relatedness = &quot;If they are related, press P\nIf they are unrelated, press Q\n\nIMPORTANT: you should press P or Q only when you see the question, AFTER the scene and item disappeared from the screen!\n\nPress SPACEBAR to start.&quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if key_related == 'q':&amp;#10;    text_relatedness = 'If they are related, press Q\nIf they are unrelated, press P\n\nIMPORTANT: you should press P or Q only when you see the question, AFTER the scene and item disappeared from the screen!\n\nPress SPACEBAR to continue.'&amp;#10;elif key_related == 'p':&amp;#10;    text_relatedness = 'If they are related, press P\nIf they are unrelated, press Q\n\nIMPORTANT: you should press P or Q only when you see the question, AFTER the scene and item disappeared from the screen!\n\nPress SPACEBAR to continue.'&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
