    <Routine name="reset_vis_vars"/>
    <LoopInitiator loopType="TrialHandler" name="visualization_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('qst_num', 0), ('question', 'Were there flowers in the scene? '), ('options', '1. Yes\n2. No'), ('correct_answer', 2), ('label_current', 'Negvi'), ('scene_again', 'stimuli/scenes/scene_J1.png')]), OrderedDict([('qst_num', 1), ('question', 'Was the ground visible? If so, was it green or brown?'), ('options', &quot;1. Yes, Brown\n2. Yes, Grassy\n3. No, the ground wasn't visable&quot;), ('correct_answer', 2), ('label_current', 'Negvi'), ('scene_again', 'stimuli/scenes/scene_J1.png')]), OrderedDict([('qst_num', 2), ('question', 'Where were the two closest tree trunks: left or right?'), ('options', '1. Left\n2. Right'), ('correct_answer', 1), ('label_current', 'Negvi'), ('scene_again', 'stimuli/scenes/scene_J1.png')]), OrderedDict([('qst_num', 3), ('question', 'Where could the sky be seen in the scene?'), ('options', '1. Upper middle section\n2. Upper right section\n3. Nowhere'), ('correct_answer', 1), ('label_current', 'Negvi'), ('scene_again', 'stimuli/scenes/scene_J1.png')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$vis_table" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="99" valType="num"/>
      <Param name="name" updates="None" val="visualization_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
