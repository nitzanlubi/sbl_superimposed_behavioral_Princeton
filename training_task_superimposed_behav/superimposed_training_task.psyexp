  <Flow>
    <Routine name="get_sub_vars"/>
    <Routine name="overall_instructions"/>
    <Routine name="part1_instructions"/>
    <LoopInitiator loopType="TrialHandler" name="trials_part1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('scene_stimulus', 'J1'), ('scene_label', 'Malbow'), ('scene_img', 'stimuli/scenes/scene_J1.png'), ('correct_key', 1)]), OrderedDict([('scene_stimulus', 'U2'), ('scene_label', 'Negvi'), ('scene_img', 'stimuli/scenes/scene_U2.png'), ('correct_key', 2)]), OrderedDict([('scene_stimulus', 'U1'), ('scene_label', 'Somar'), ('scene_img', 'stimuli/scenes/scene_U1.png'), ('correct_key', 3)]), OrderedDict([('scene_stimulus', 'J2'), ('scene_label', 'Tulon'), ('scene_img', 'stimuli/scenes/scene_J2.png'), ('correct_key', 4)])]" valType="str"/>
