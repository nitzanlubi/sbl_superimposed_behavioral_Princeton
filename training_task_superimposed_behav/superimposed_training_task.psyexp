        <Param val="count = 0&amp;#10;#adding a shuffling procedure so the order is randomized:&amp;#10;labelStr = [&quot;J1&quot;, &quot;J2&quot;, &quot;U1&quot;, &quot;U2&quot;]&amp;#10;shuffle(labelStr)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
