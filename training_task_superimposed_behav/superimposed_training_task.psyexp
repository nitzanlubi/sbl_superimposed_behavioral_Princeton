        <Param val="if ((key_jungle === &quot;1&quot;)) {&amp;#10;    context_jungle_txt = (&quot;1. &quot; + &quot;Jungle&quot;);&amp;#10;    pos_jungle = [0, 0.06];&amp;#10;    context_sea_txt = (&quot;2. &quot; + &quot;Undersea&quot;);&amp;#10;    pos_sea = [0, 0];&amp;#10;} else {&amp;#10;    if ((key_jungle === &quot;2&quot;)) {&amp;#10;        context_sea_txt = (&quot;1. &quot; + &quot;Undersea&quot;);&amp;#10;        pos_sea = [0, 0.06];&amp;#10;        context_jungle_txt = (&quot;2. &quot; + &quot;Jungle&quot;);&amp;#10;        pos_jungle = [0, 0];&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# create the text for select context screen based &amp;#10;#on participant's colors and keys&amp;#10;&amp;#10;#    key_desert = '2'&amp;#10;#    key_ocean = '1'    &amp;#10;#    color_desert = 'Purple'&amp;#10;#    color_ocean = 'Pink'&amp;#10;&amp;#10;if key_jungle == '1':&amp;#10;    context_jungle_txt = '1. ' + 'Jungle'&amp;#10;    pos_jungle = (0,0.06)&amp;#10;    context_sea_txt = '2. ' + 'Undersea'&amp;#10;    pos_sea = (0,0)&amp;#10;elif key_jungle == '2':&amp;#10;    context_sea_txt = '1. ' + 'Undersea'&amp;#10;    pos_sea = (0,0.06)&amp;#10;    context_jungle_txt = '2. ' + 'Jungle'&amp;#10;    pos_jungle = (0,0)" valType="extendedCode" updates="constant" name="Begin Routine"/>
