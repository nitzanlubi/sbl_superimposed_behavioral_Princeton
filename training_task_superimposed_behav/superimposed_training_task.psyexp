        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((sub_conds[2] === 0)) {&amp;#10;    key_jungle = &quot;1&quot;;&amp;#10;    key_sea = &quot;2&quot;;&amp;#10;} else {&amp;#10;    key_jungle = &quot;2&quot;;&amp;#10;    key_sea = &quot;1&quot;;&amp;#10;}&amp;#10;if ((sub_conds[3] === 0)) {&amp;#10;    color_jungle = &quot;purple&quot;;&amp;#10;    color_sea = &quot;pink&quot;;&amp;#10;} else {&amp;#10;    color_jungle = &quot;pink&quot;;&amp;#10;    color_sea = &quot;purple&quot;;&amp;#10;}&amp;#10;if ((sub_conds[4] === 0)) {&amp;#10;    key_J1 = &quot;1&quot;;&amp;#10;    key_J2 = &quot;2&quot;;&amp;#10;} else {&amp;#10;    key_J1 = &quot;2&quot;;&amp;#10;    key_J2 = &quot;1&quot;;&amp;#10;}&amp;#10;if ((sub_conds[5] === 0)) {&amp;#10;    key_U1 = &quot;1&quot;;&amp;#10;    key_U2 = &quot;2&quot;;&amp;#10;} else {&amp;#10;    key_U1 = &quot;2&quot;;&amp;#10;    key_U2 = &quot;1&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;# assign context keys&amp;#10;if sub_conds[2] == 0:&amp;#10;    key_jungle = '1'&amp;#10;    key_sea = '2'&amp;#10;else:&amp;#10;    key_jungle = '2'&amp;#10;    key_sea = '1'&amp;#10;&amp;#10;# assign categories color&amp;#10;if sub_conds[3] == 0:&amp;#10;    color_jungle = 'purple'&amp;#10;    color_sea = 'pink'&amp;#10;else:&amp;#10;    color_jungle = 'pink'&amp;#10;    color_sea = 'purple'&amp;#10;&amp;#10;# assign desert label key numbers:&amp;#10;if sub_conds[4] == 0:&amp;#10;    # '1'--&gt; jungle A; '2' --&gt; jungle B&amp;#10;    key_J1 = '1'&amp;#10;    key_J2 = '2'&amp;#10;else: &amp;#10;    # '1'--&gt; jungle B; '2' --&gt; jungle A&amp;#10;    key_J1 = '2'&amp;#10;    key_J2 = '1' &amp;#10;&amp;#10;# assign sea label key numbers:&amp;#10;if sub_conds[5] == 0:&amp;#10;    # '1'--&gt; sea A; '2' --&gt; sea B&amp;#10;    key_U1 = '1'&amp;#10;    key_U2 = '2'&amp;#10;else: &amp;#10;    # '1'--&gt; sea B; '2' --&gt; sea A&amp;#10;    key_U1 = '2'&amp;#10;    key_U2 = '1'   " valType="extendedCode" updates="constant" name="Begin Routine"/>
