        <Param val="if ((key_part2.corr === 1)) {&amp;#10;    logic_vec[(correct_key - 1)] = true;&amp;#10;} else {&amp;#10;    if ((key_part2.corr === 0)) {&amp;#10;        logic_vec[(correct_key - 1)] = false;&amp;#10;    }&amp;#10;}&amp;#10;if (all(logic_vec)) {&amp;#10;    part2_loop.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if(key_part2.corr ==1):&amp;#10;    logic_vec[correct_key-1] = True&amp;#10;elif (key_part2.corr ==0):&amp;#10;    logic_vec[correct_key-1] = False&amp;#10;&amp;#10;if all(logic_vec):&amp;#10;    part2_loop.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
