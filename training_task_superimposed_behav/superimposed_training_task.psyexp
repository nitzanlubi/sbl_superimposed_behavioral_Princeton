        <Param val="# create the text to present for the desert scene labels &amp;#10;# according to counterbalanced variables&amp;#10;&amp;#10;# get the unique scene_stimulus and their corresponding scene_label&amp;#10;&amp;#10;labels = df[['scene_stimulus', 'scene_label']]&amp;#10;labels = dict(zip(labels['scene_stimulus'], labels['scene_label']))&amp;#10;# Set jungle labels text for scene label screen&amp;#10;if key_J1 == '1':&amp;#10;    jungle_lbl_text = '1.' + labels['J1'] + '\n2.' + labels['J2'] &amp;#10;elif key_J1 == '2':&amp;#10;    jungle_lbl_text = '1.' + labels['J2'] + '\n2.' + labels['J1'] &amp;#10;&amp;#10;# Set sea labels text for scene label screen&amp;#10;if key_U1 == '1':&amp;#10;    sea_lbl_text = '1.' + labels['U1'] + '\n2.' + labels['U2'] &amp;#10;elif key_U1 == '2':&amp;#10;    sea_lbl_text = '1.' + labels['U2'] + '\n2.' + labels['U1'] " valType="extendedCode" updates="constant" name="Begin Routine"/>
